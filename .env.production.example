APP_NAME="SGI Immo"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://votre-domaine.com

LOG_CHANNEL=stack
LOG_LEVEL=error

# ── Base de données MySQL O2switch ──────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=nom_de_votre_bdd
DB_USERNAME=utilisateur_bdd
DB_PASSWORD=mot_de_passe_bdd

# ── Sessions & Cache ─────────────────────────────────────────────────────────
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# ── Mail (optionnel) ─────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mail.votre-domaine.com
MAIL_PORT=465
MAIL_USERNAME=contact@votre-domaine.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=contact@votre-domaine.com
MAIL_FROM_NAME="SGI Immo"
